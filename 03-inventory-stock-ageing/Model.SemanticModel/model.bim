            "dataType": "decimal",
            "sourceColumn": "UnitCost",
            "summarizeBy": "none",
            "lineageTag": "079581a5-0b12-528b-adba-b8a81f839429"
          }
        ],
        "partitions": [
          {
            "name": "Stock",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Stock.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"LotID\", type text}, {\"ProductID\", type text}, {\"Warehouse\", type text}, {\"SnapshotDate\", type date}, {\"ReceiptDate\", type date}, {\"AgeDays\", Int64.Type}, {\"AgeBand\", type text}, {\"OnHand\", Int64.Type}, {\"Reserved\", Int64.Type}, {\"UnitCost\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Metrics",
        "lineageTag": "c3330859-c0aa-58d2-9088-42ffd92fcd4f",
        "columns": [
          {
            "name": "Label",
            "dataType": "string",
            "sourceColumn": "Label",
            "summarizeBy": "none",
            "lineageTag": "b0d05eef-241e-503f-891a-542e2bee5cfd",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"80lMSs3hCo70C/FwDfF0VnBx9fXnAgA=\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Metrics.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "On Hand Units",
            "expression": "SUM(Stock[OnHand])",
            "formatString": "#,0",
            "description": "Sum of OnHand at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "fa94d798-48c8-5d4f-81fb-986b312124d1"
          },
          {
            "name": "Reserved Units",
            "expression": "SUM(Stock[Reserved])",
            "formatString": "#,0",
            "description": "Sum of Reserved at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "83c84ecb-14f2-5d7c-ba9f-555933e704a8"
          },
          {
            "name": "Available Units",
            "expression": "[On Hand Units] - [Reserved Units]",
            "formatString": "#,0",
            "description": "Physical stock less reservations.",
            "displayFolder": "Business metrics",
            "lineageTag": "6b236747-3c10-5294-a96b-807690a35c89"
          },
          {
            "name": "Stock Value",
            "expression": "SUMX(Stock, Stock[OnHand] * Stock[UnitCost])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Physical stock valued at lot unit cost.",
            "displayFolder": "Business metrics",
            "lineageTag": "73afc16d-93bc-526f-8ae4-2e1367c5b73c"
          },
          {
            "name": "Available Value",
            "expression": "SUMX(Stock, (Stock[OnHand] - Stock[Reserved]) * Stock[UnitCost])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Unreserved stock valued at cost.",
            "displayFolder": "Business metrics",
            "lineageTag": "9992a921-420a-57e8-8b50-b3507468b022"
          },
          {
            "name": "Aged Units",
            "expression": "CALCULATE([On Hand Units], KEEPFILTERS(Stock[AgeDays] > 90))",
            "formatString": "#,0",
            "description": "Stock received more than 90 days before the snapshot.",
            "displayFolder": "Business metrics",
            "lineageTag": "56d1d4c4-b705-504c-9884-1f8650143297"
          },
          {
            "name": "Aged Value",
            "expression": "CALCULATE([Stock Value], KEEPFILTERS(Stock[AgeDays] > 90))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Value of stock older than 90 days.",
            "displayFolder": "Business metrics",
            "lineageTag": "70a98335-53c6-5661-927c-fb9ade142b44"
          },
          {
            "name": "Aged Value Share",
            "expression": "DIVIDE([Aged Value], [Stock Value])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Aged value / all selected stock value.",
            "displayFolder": "Business metrics",
            "lineageTag": "e9296dc7-99f4-5fc2-883f-dc72f3ffc945"
          },
          {
            "name": "Weighted Stock Age",
            "expression": "DIVIDE(SUMX(Stock, Stock[AgeDays] * Stock[OnHand]), [On Hand Units])",
            "formatString": "#,0.0",
            "description": "Unit-weighted age of on-hand stock.",
            "displayFolder": "Business metrics",
            "lineageTag": "965e6823-1563-50a0-b3c9-2ad3f14f0f6c"
          },
          {
            "name": "Occupied Lots",
            "expression": "COUNTROWS(FILTER(Stock, Stock[OnHand] > 0))",
            "formatString": "#,0",
            "description": "Lots with positive physical stock.",
            "displayFolder": "Business metrics",
            "lineageTag": "a8cc9fef-52d9-5be0-a943-298f52247e7d"
          },
          {
            "name": "Reserved Share",
            "expression": "DIVIDE([Reserved Units], [On Hand Units])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Reserved units / on-hand units.",
            "displayFolder": "Business metrics",
            "lineageTag": "ccd7241a-f0d4-5812-98c1-e6dbc386d5af"
          },
          {
            "name": "Product Count",
            "expression": "DISTINCTCOUNT(Stock[ProductID])",
            "formatString": "#,0",
            "description": "Distinct products represented in selected snapshot lots.",
            "displayFolder": "Business metrics",
            "lineageTag": "4f27941d-2ce6-5a8c-9b2b-87542c8dc8ac"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "52333c5e-a136-536b-a430-af59770b476b",
        "fromTable": "Stock",
        "fromColumn": "ProductID",
        "toTable": "Products",
        "toColumn": "ProductID",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one"
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"Folder\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/PowerBI/data-powerbi-portfolio/03-inventory-stock-ageing/data/demo\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
