              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Recognized Revenue",
            "expression": "SUM(Performance[RecognizedRevenue])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Accrual revenue recognized for the reporting period.",
            "displayFolder": "Business metrics",
            "lineageTag": "8f8d49d7-9e73-5834-9cc5-b0bc9bcb97dd"
          },
          {
            "name": "Labor Cost",
            "expression": "SUM(Performance[LaborCost])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of LaborCost at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "8e9a75c8-cd9f-58db-9012-626085b5f64d"
          },
          {
            "name": "Subcontract Cost",
            "expression": "SUM(Performance[SubcontractCost])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of SubcontractCost at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "235cef96-f582-512c-afcf-5401be456a25"
          },
          {
            "name": "Expenses",
            "expression": "SUM(Performance[Expenses])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of Expenses at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "dc45819c-0fd9-5c02-aa3e-422aefd9fe58"
          },
          {
            "name": "Delivery Cost",
            "expression": "[Labor Cost] + [Subcontract Cost] + [Expenses]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Direct project delivery cost excluding general overhead.",
            "displayFolder": "Business metrics",
            "lineageTag": "41b0a7d5-10be-53e8-94b5-4fa044063535"
          },
          {
            "name": "Project Profit",
            "expression": "[Recognized Revenue] - [Delivery Cost]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Recognized revenue less direct delivery cost.",
            "displayFolder": "Business metrics",
            "lineageTag": "567644e8-0c7c-5e18-b0dc-4d59849aa2d3"
          },
          {
            "name": "Project Margin",
            "expression": "DIVIDE([Project Profit], [Recognized Revenue])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Project profit / recognized revenue.",
            "displayFolder": "Business metrics",
            "lineageTag": "4724d629-be8c-53a3-95ae-9f358a017ff8"
          },
          {
            "name": "Cost Budget",
            "expression": "SUM(Performance[CostBudget])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Monthly allocated direct delivery budget.",
            "displayFolder": "Business metrics",
            "lineageTag": "b4420c8a-7593-58d0-8b8f-5e8ab058ca80"
          },
          {
            "name": "Budget Remaining",
            "expression": "[Cost Budget] - [Delivery Cost]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Allocated budget less actual cost; positive is under budget.",
            "displayFolder": "Business metrics",
            "lineageTag": "17c4922b-20f5-5280-9497-27f952d41971"
          },
          {
            "name": "Actual Hours",
            "expression": "SUM(Performance[ActualHours])",
            "formatString": "#,0",
            "description": "Sum of ActualHours at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "a6a71efb-6230-5eef-a4a0-00d0a1255560"
          },
          {
            "name": "Planned Hours",
            "expression": "SUM(Performance[PlannedHours])",
            "formatString": "#,0",
            "description": "Sum of PlannedHours at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "d31fcf81-4272-59ff-85d8-a5adbd2bba8c"
          },
          {
            "name": "Hours Variance",
            "expression": "[Actual Hours] - [Planned Hours]",
            "formatString": "#,0",
            "description": "Positive means more hours consumed than planned.",
            "displayFolder": "Business metrics",
            "lineageTag": "87b419db-a9b4-54a6-a566-9b973b8209f6"
          },
          {
            "name": "Effective Revenue per Hour",
            "expression": "DIVIDE([Recognized Revenue], [Actual Hours])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Recognized revenue per actual delivery hour.",
            "displayFolder": "Business metrics",
            "lineageTag": "9e9a36c1-3d64-51e2-8bea-4b2c6874200a"
          },
          {
            "name": "Invoiced",
            "expression": "SUM(Performance[Invoiced])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of Invoiced at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "fa431fa0-353f-54a7-931f-77d31cad399e"
          },
          {
            "name": "Collected",
            "expression": "SUM(Performance[Collected])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of Collected at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "f470689a-1df6-5669-a15b-182817a9ffe4"
          },
          {
            "name": "Invoice Cash Gap",
            "expression": "[Invoiced] - [Collected]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Selected-period invoices minus collections. Not accounts-receivable balance or overdue debt.",
            "displayFolder": "Business metrics",
            "lineageTag": "2a909266-0813-5a44-8f2b-6bc147c0c010"
          }
        ]
      },
