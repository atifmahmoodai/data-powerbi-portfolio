              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "CALCULATE(SUM(PnL[Actual]), PnL[Category] = \"Revenue\")",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Accrual revenue; not customer receipts.",
            "displayFolder": "Business metrics",
            "lineageTag": "429baba1-745d-52d3-b65f-91795ed03ca6"
          },
          {
            "name": "Cost of Sales",
            "expression": "CALCULATE(SUM(PnL[Actual]), PnL[Category] = \"COGS\")",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Positive cost of goods sold.",
            "displayFolder": "Business metrics",
            "lineageTag": "88c2f2d8-bb6a-5d15-b564-8e5b124af54c"
          },
          {
            "name": "Operating Expense",
            "expression": "CALCULATE(SUM(PnL[Actual]), PnL[Category] = \"Operating Expense\")",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Positive operating expense excluding COGS.",
            "displayFolder": "Business metrics",
            "lineageTag": "ca41003d-216c-5e3f-9b04-8413032cd3a1"
          },
          {
            "name": "Gross Profit",
            "expression": "[Revenue] - [Cost of Sales]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Revenue less COGS.",
            "displayFolder": "Business metrics",
            "lineageTag": "f118b937-42d7-50d2-9872-d96bc68d05cc"
          },
          {
            "name": "Operating Profit",
            "expression": "[Gross Profit] - [Operating Expense]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Before interest, tax and exceptional items.",
            "displayFolder": "Business metrics",
            "lineageTag": "b5a643f8-7d81-510c-9fc3-04037be7d295"
          },
          {
            "name": "Operating Margin",
            "expression": "DIVIDE([Operating Profit], [Revenue])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Operating profit / accrual revenue.",
            "displayFolder": "Business metrics",
            "lineageTag": "ab9ca607-3573-5e6f-a161-c9fc5363a269"
          },
          {
            "name": "Budget Profit",
            "expression": "SUMX(PnL, IF(PnL[Category] = \"Revenue\", PnL[Budget], -PnL[Budget]))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Budget revenue less budget costs.",
            "displayFolder": "Business metrics",
            "lineageTag": "04553248-35f2-5dfb-b9c2-9960e4f43f03"
          },
          {
            "name": "Profit Variance",
            "expression": "[Operating Profit] - [Budget Profit]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Positive means operating profit ahead of budget.",
            "displayFolder": "Business metrics",
            "lineageTag": "53b6d2ee-c757-5852-bef2-cf7444458a65"
          },
          {
            "name": "Signed Actual",
            "expression": "SUMX(PnL, IF(PnL[Category] = \"Revenue\", PnL[Actual], -PnL[Actual]))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Category-level signed P&L contribution.",
            "displayFolder": "Business metrics",
            "lineageTag": "bbeadc42-c1b3-5e41-ad93-c467307bc249"
          },
          {
            "name": "Signed Budget",
            "expression": "SUMX(PnL, IF(PnL[Category] = \"Revenue\", PnL[Budget], -PnL[Budget]))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Category-level signed budget contribution.",
            "displayFolder": "Business metrics",
            "lineageTag": "82d55ed5-8cb7-5449-94a9-4209be1060af"
          },
          {
            "name": "Cash Inflow",
            "expression": "CALCULATE(SUM(Cash[CashMovement]), KEEPFILTERS(Cash[CashMovement] > 0))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "All positive cash movements including financing.",
            "displayFolder": "Business metrics",
            "lineageTag": "b0f23942-1a7f-5776-a6de-802b42db1acb"
          },
          {
            "name": "Cash Outflow",
            "expression": "-CALCULATE(SUM(Cash[CashMovement]), KEEPFILTERS(Cash[CashMovement] < 0))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Absolute value of all negative cash movements.",
            "displayFolder": "Business metrics",
            "lineageTag": "1e8dfa14-2453-55b2-b401-baa86617760c"
          },
          {
            "name": "Net Cash Movement",
            "expression": "SUM(Cash[CashMovement])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Cash receipts less payments; not a cash balance.",
            "displayFolder": "Business metrics",
            "lineageTag": "14f72b23-7f93-5283-9fa4-317a0314385d"
          },
          {
            "name": "Operating Cash Movement",
            "expression": "CALCULATE([Net Cash Movement], KEEPFILTERS(Cash[Category] IN {\"Customer Receipts\", \"Supplier Payments\", \"Payroll\"}))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Receipts less supplier payments and payroll; excludes capex and loans.",
            "displayFolder": "Business metrics",
            "lineageTag": "7d60f42c-8eb7-5b5f-8ee7-9001adf2719e"
          }
        ]
      },
