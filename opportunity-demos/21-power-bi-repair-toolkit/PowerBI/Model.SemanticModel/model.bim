        "columns": [
          {
            "name": "period",
            "dataType": "string",
            "sourceColumn": "period",
            "summarizeBy": "none",
            "lineageTag": "afed70a2-136f-5547-9142-fab205a1ca40"
          },
          {
            "name": "group",
            "dataType": "string",
            "sourceColumn": "group",
            "summarizeBy": "none",
            "lineageTag": "d7a684e4-7cda-5d51-baff-1c91fa337a70"
          },
          {
