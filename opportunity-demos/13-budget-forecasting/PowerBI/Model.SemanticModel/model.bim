            "summarizeBy": "none",
            "lineageTag": "2e47dc7c-756e-5a7f-97f2-ea1f8fd65584"
          }
        ],
        "measures": [
          {
            "name": "Actual Spend",
            "expression": "SUM(Data[actual])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Actual Spend",
            "lineageTag": "f983a137-f29a-5453-aaab-d10eebd3a32f"
          },
          {
            "name": "Budget",
            "expression": "SUM(Data[target])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Budget",
            "lineageTag": "200bc4c4-78ff-5057-827f-9d35629010ab"
          },
          {
            "name": "Budget Variance",
            "expression": "SUM(Data[target]) - SUM(Data[actual])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Budget Variance",
            "lineageTag": "10776100-4f1c-5f89-a842-7ae9fc612b5a"
          },
          {
            "name": "Variance Percent",
            "expression": "DIVIDE([Budget Variance], [Budget])",
            "formatString": "0.0%",
            "displayFolder": "Analytics",
            "description": "Variance Percent",
            "lineageTag": "02a87169-fb70-5e6c-a915-0b06a53891a3"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"variance\", Currency.Type}, {\"variancepct\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/13-budget-forecasting/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
