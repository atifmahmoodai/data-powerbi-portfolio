            "dataType": "decimal",
            "sourceColumn": "units",
            "summarizeBy": "none",
            "lineageTag": "fbfe77d7-9fe1-546b-a0ed-f89e28025488"
          },
          {
            "name": "extra",
            "dataType": "decimal",
            "sourceColumn": "extra",
            "summarizeBy": "none",
            "lineageTag": "cee43e2a-d247-5e3b-b081-9c8f672f88a8"
          },
          {
            "name": "roas",
            "dataType": "decimal",
            "sourceColumn": "roas",
            "summarizeBy": "none",
            "lineageTag": "9ab3199a-b8f3-558f-bc1f-bbfe2f39064f"
          }
        ],
        "measures": [
          {
            "name": "Attributed Revenue",
            "expression": "SUM(Data[actual])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Attributed Revenue",
            "lineageTag": "b68234c8-aa46-5d12-beef-4099d24dca4a"
          },
          {
            "name": "Ad Spend",
            "expression": "SUM(Data[cost])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Ad Spend",
            "lineageTag": "474ececd-e855-54e4-899a-c46b410c6e1c"
          },
          {
            "name": "ROAS",
            "expression": "DIVIDE([Attributed Revenue], [Ad Spend])",
            "formatString": "0.00x",
            "displayFolder": "Analytics",
            "description": "ROAS",
            "lineageTag": "ed83916b-e101-5986-bf07-9cbb4662a514"
          },
          {
            "name": "Conversions",
            "expression": "SUM(Data[units])",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Conversions",
            "lineageTag": "fc6e5952-a267-5a4a-b8b8-80296c271317"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"roas\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/18-marketing-analytics/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
