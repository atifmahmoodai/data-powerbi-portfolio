            "dataType": "decimal",
            "sourceColumn": "extra",
            "summarizeBy": "none",
            "lineageTag": "52dffd09-b293-50f7-89a5-ed4d6a2b9197"
          },
          {
            "name": "issue",
            "dataType": "decimal",
            "sourceColumn": "issue",
            "summarizeBy": "none",
            "lineageTag": "b760192c-7938-5843-a0f1-a33a36397ce0"
          },
          {
            "name": "fail",
            "dataType": "decimal",
            "sourceColumn": "fail",
            "summarizeBy": "none",
            "lineageTag": "0ea78384-674c-5a4e-a44d-f5cb41af27da"
          }
        ],
        "measures": [
          {
            "name": "Readiness Score",
            "expression": "AVERAGE(Data[actual])",
            "formatString": "0.0",
            "displayFolder": "Analytics",
            "description": "Readiness Score",
            "lineageTag": "7153f9d2-61b9-5727-acc7-364ac23888e6"
          },
          {
            "name": "Checks Reviewed",
            "expression": "COUNTROWS(Data)",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Checks Reviewed",
            "lineageTag": "80b01de7-4a80-578f-b9b3-d64c32251adf"
          },
          {
            "name": "Issues",
            "expression": "CALCULATE(COUNTROWS(Data), Data[status] IN {\"Review\", \"Fail\"})",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Issues",
            "lineageTag": "d9321bad-340e-5525-9b54-cd9029e4acbb"
          },
          {
            "name": "Failed Checks",
            "expression": "CALCULATE(COUNTROWS(Data), Data[status] = \"Fail\")",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Failed Checks",
            "lineageTag": "e672e0b8-da5a-5540-8f91-90143322bff5"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"issue\", Currency.Type}, {\"fail\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/21-power-bi-repair-toolkit/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
