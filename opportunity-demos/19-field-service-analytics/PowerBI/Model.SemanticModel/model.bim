            "summarizeBy": "none",
            "lineageTag": "7b2255b6-6044-5055-bcd5-75f446f584e7"
          }
        ],
        "measures": [
          {
            "name": "Service Jobs Logged",
            "expression": "COUNTROWS(Data)",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Service Jobs Logged",
            "lineageTag": "a78f9b1c-db82-5fc4-9d6c-6a36739e7738"
          },
          {
            "name": "SLA Breaches",
            "expression": "CALCULATE(COUNTROWS(Data), Data[status] = \"SLA breach\")",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "SLA Breaches",
            "lineageTag": "cbf4e1a1-379c-501f-a93f-06a2553e3a89"
          },
          {
            "name": "Service Revenue",
            "expression": "SUM(Data[actual])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Service Revenue",
            "lineageTag": "8de57237-0475-5e98-b070-5f22da39a20e"
          },
          {
            "name": "Service Cost",
            "expression": "SUM(Data[cost])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Service Cost",
            "lineageTag": "aa01d08b-2939-5b61-833d-bfe901af9a39"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"breach\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/19-field-service-analytics/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
