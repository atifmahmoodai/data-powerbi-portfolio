        ],
        "measures": [
          {
            "name": "Observed Units",
            "expression": "SUM(Data[units])",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Observed Units",
            "lineageTag": "1dd649c7-8e0d-514f-bf92-6a2075ae3365"
          },
          {
            "name": "Forecast Units",
            "expression": "SUM(Data[target])",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Forecast Units",
            "lineageTag": "f4fc2261-ae58-5d1f-9b52-9fcf5538b449"
          },
          {
            "name": "Unit Variance",
            "expression": "SUM(Data[units]) - SUM(Data[target])",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Unit Variance",
            "lineageTag": "ce5c0c34-6159-58c8-89df-dfcd359ae1a9"
          },
          {
            "name": "Short Cover SKU Periods",
            "expression": "CALCULATE(COUNTROWS(Data), Data[status] = \"Short cover\")",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Short Cover SKU Periods",
            "lineageTag": "758cbba4-a863-542f-8d8b-6b067d0b523b"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"targetunits\", Currency.Type}, {\"mape\", Currency.Type}, {\"risk\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/16-demand-planning/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
