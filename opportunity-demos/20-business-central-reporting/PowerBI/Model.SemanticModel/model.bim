          },
          {
            "name": "extra",
            "dataType": "decimal",
            "sourceColumn": "extra",
            "summarizeBy": "none",
            "lineageTag": "cde97d7b-105a-5921-9d20-16236eeaaadf"
          },
          {
            "name": "variance",
            "dataType": "decimal",
            "sourceColumn": "variance",
            "summarizeBy": "none",
            "lineageTag": "3b0b0ac8-9d25-58df-adb4-ff11300c4f86"
          }
        ],
        "measures": [
          {
            "name": "Net Ledger Amount",
            "expression": "SUM(Data[actual]) - SUM(Data[cost])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Net Ledger Amount",
            "lineageTag": "55716b04-5317-5d23-a9e8-958525cecb21"
          },
          {
            "name": "Ledger Lines",
            "expression": "COUNTROWS(Data)",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Ledger Lines",
            "lineageTag": "caae02ca-1552-584c-8513-ab89742c0fee"
          },
          {
            "name": "Review Lines",
            "expression": "CALCULATE(COUNTROWS(Data), Data[status] = \"Review\")",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Review Lines",
            "lineageTag": "93ebcce3-e3cc-5206-b138-28d49cb29785"
          },
          {
            "name": "Control Variance",
            "expression": "SUM(Data[actual]) - SUM(Data[target])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Control Variance",
            "lineageTag": "3641d741-58e0-5b8e-8073-3a083c78fab1"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"variance\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/20-business-central-reporting/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
