        ],
        "partitions": [
          {
            "name": "Jobs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Jobs.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"JobID\", type text}, {\"TeamID\", type text}, {\"Service\", type text}, {\"Priority\", type text}, {\"CreatedDate\", type date}, {\"DueDate\", type date}, {\"CompletedDate\", type date}, {\"Status\", type text}, {\"CycleDays\", Int64.Type}, {\"OnTime\", Int64.Type}, {\"Rework\", Int64.Type}, {\"Cost\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Metrics",
        "lineageTag": "2b47e7d0-2dcd-5bc5-9551-3436a3dc6488",
        "columns": [
          {
            "name": "Label",
            "dataType": "string",
            "sourceColumn": "Label",
            "summarizeBy": "none",
            "lineageTag": "4c886701-f52d-5fa9-be20-5309d41154ee",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"80lMSs3hCo70C/FwDfF0VnBx9fXnAgA=\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Metrics.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Jobs Created",
            "expression": "COUNTROWS(Jobs)",
            "formatString": "#,0",
            "description": "Jobs in selected creation-date cohorts.",
            "displayFolder": "Business metrics",
            "lineageTag": "fd678cc0-dd82-52e9-8879-441aa91b3998"
          },
          {
            "name": "Completed Jobs",
            "expression": "CALCULATE(COUNTROWS(Jobs), KEEPFILTERS(Jobs[Status] = \"Completed\"))",
            "formatString": "#,0",
            "description": "Currently completed jobs in selected creation cohorts.",
            "displayFolder": "Business metrics",
            "lineageTag": "d5f64e8e-c30d-55ed-b05a-9a439b2cdfd6"
          },
          {
            "name": "Open Jobs",
            "expression": "CALCULATE(COUNTROWS(Jobs), KEEPFILTERS(Jobs[Status] = \"Open\"))",
            "formatString": "#,0",
            "description": "Current unfinished jobs in selected creation cohorts.",
            "displayFolder": "Business metrics",
            "lineageTag": "6ae63621-02f3-5c6c-81af-7acd92ebd441"
          },
          {
            "name": "Completion Rate",
            "expression": "DIVIDE([Completed Jobs], [Jobs Created])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Completed jobs / created jobs in cohort; not daily throughput.",
            "displayFolder": "Business metrics",
            "lineageTag": "a14b30bb-80b2-5994-88f3-bc6fd98975e9"
          },
          {
            "name": "On Time Jobs",
            "expression": "SUM(Jobs[OnTime])",
            "formatString": "#,0",
            "description": "Completed jobs by due date.",
            "displayFolder": "Business metrics",
            "lineageTag": "7f5772c5-f584-5a32-8040-9a0435749243"
          },
          {
            "name": "On Time Rate",
            "expression": "DIVIDE([On Time Jobs], [Completed Jobs])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Completed on-time jobs / all completed jobs.",
            "displayFolder": "Business metrics",
            "lineageTag": "9db2d6c7-2046-5506-b45d-523174a6cfcb"
          },
          {
            "name": "Average Cycle Days",
            "expression": "CALCULATE(AVERAGE(Jobs[CycleDays]), KEEPFILTERS(Jobs[Status] = \"Completed\"))",
            "formatString": "#,0.0",
            "description": "Mean creation-to-completion days for finished work.",
            "displayFolder": "Business metrics",
            "lineageTag": "cf1f50c0-06ae-548f-a30b-4f60ac148ea3"
          },
          {
            "name": "Overdue Open Jobs",
            "expression": "CALCULATE([Open Jobs], KEEPFILTERS(Jobs[DueDate] < DATE(2026,9,30)))",
            "formatString": "#,0",
            "description": "Open jobs whose due date precedes the demo snapshot date.",
            "displayFolder": "Business metrics",
            "lineageTag": "bedcde1d-f9ab-52ce-9dcd-680e1205d82b"
          },
          {
            "name": "Rework Jobs",
            "expression": "SUM(Jobs[Rework])",
            "formatString": "#,0",
            "description": "Completed jobs flagged for rework.",
            "displayFolder": "Business metrics",
            "lineageTag": "c6bffec7-6438-5206-97c8-9ec53477fc26"
          },
          {
            "name": "Rework Rate",
            "expression": "DIVIDE([Rework Jobs], [Completed Jobs])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Reworked completed jobs / completed jobs.",
            "displayFolder": "Business metrics",
            "lineageTag": "01edfd34-b88e-5dfc-aa00-3893083830fa"
          },
          {
            "name": "First Pass Yield",
            "expression": "DIVIDE([Completed Jobs] - [Rework Jobs], [Completed Jobs])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Completed without rework / all completed jobs.",
            "displayFolder": "Business metrics",
            "lineageTag": "ef84f3b4-a7ee-5f5f-b685-2a5bdebb10ee"
          },
          {
            "name": "Recorded Cost",
            "expression": "SUM(Jobs[Cost])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Recorded cost incurred on all selected jobs; open jobs included.",
            "displayFolder": "Business metrics",
            "lineageTag": "5c83d594-de97-5eec-b4c2-0554325da7e7"
          },
          {
            "name": "Cost per Completed Job",
            "expression": "DIVIDE(CALCULATE(SUM(Jobs[Cost]), KEEPFILTERS(Jobs[Status] = \"Completed\")), [Completed Jobs])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Cost associated with completed jobs / completed count.",
            "displayFolder": "Business metrics",
            "lineageTag": "cfcceacb-2a78-596c-ab75-49574ba7302d"
          }
        ]
      },
