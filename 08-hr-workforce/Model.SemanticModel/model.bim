      {
        "name": "Metrics",
        "lineageTag": "56bca1e6-7366-5b37-8c67-7cc843c51756",
        "columns": [
          {
            "name": "Label",
            "dataType": "string",
            "sourceColumn": "Label",
            "summarizeBy": "none",
            "lineageTag": "7ab01429-70c6-58f0-99f3-e795148c9a0e",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"80lMSs3hCo70C/FwDfF0VnBx9fXnAgA=\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Metrics.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Headcount",
            "expression": "VAR LastMonth = MAX(Workforce[Date]) RETURN CALCULATE(SUM(Workforce[ClosingHeadcount]), Workforce[Date] = LastMonth)",
            "formatString": "#,0",
            "description": "Closing headcount at the latest snapshot in the selected period; never sum months.",
            "displayFolder": "Business metrics",
            "lineageTag": "c3b4f2f7-7edf-5904-a4ca-632fd76d0dce"
          },
          {
            "name": "Average Opening Headcount",
            "expression": "AVERAGEX(VALUES(Workforce[Date]), CALCULATE(SUM(Workforce[OpeningHeadcount])))",
            "formatString": "#,0.0",
            "description": "Average of selected monthly opening headcounts.",
            "displayFolder": "Business metrics",
            "lineageTag": "2afbb4dd-8dfa-568f-a111-913d10548594"
          },
          {
            "name": "Hires",
            "expression": "SUM(Workforce[Hires])",
            "formatString": "#,0",
            "description": "Sum of Hires at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "ac8525ac-d851-5383-b9aa-6c7268e5fbec"
          },
          {
            "name": "Leavers",
            "expression": "SUM(Workforce[Leavers])",
            "formatString": "#,0",
            "description": "Sum of Leavers at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "2ef48ba0-b5a0-5b4f-8c5c-416f6f46eabe"
          },
          {
            "name": "Net Hiring",
            "expression": "[Hires] - [Leavers]",
            "formatString": "#,0",
            "description": "Period hires less leavers.",
            "displayFolder": "Business metrics",
            "lineageTag": "bb9e26fc-522e-53fa-b30b-fbade360858f"
          },
          {
            "name": "Period Attrition",
            "expression": "DIVIDE([Leavers], [Average Opening Headcount])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Leavers in selected months / average monthly opening headcount. Period rate, not annualized.",
            "displayFolder": "Business metrics",
            "lineageTag": "12545cda-f7cb-5dc8-9a05-b8f1747c42ae"
          },
          {
            "name": "Scheduled Hours",
            "expression": "SUM(Workforce[ScheduledHours])",
            "formatString": "#,0",
            "description": "Sum of ScheduledHours at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "8a44e9ed-7093-58fc-b766-e62593467e7e"
          },
          {
            "name": "Absent Hours",
            "expression": "SUM(Workforce[AbsentHours])",
            "formatString": "#,0",
            "description": "Sum of AbsentHours at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "c9b0f390-d2cb-5738-8e91-056e912036e5"
          },
          {
            "name": "Absence Rate",
            "expression": "DIVIDE([Absent Hours], [Scheduled Hours])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Absent hours / scheduled hours.",
            "displayFolder": "Business metrics",
            "lineageTag": "f468d399-b6e5-50a4-9a6d-aa8f30e7a892"
          },
          {
            "name": "Overtime Hours",
            "expression": "SUM(Workforce[OvertimeHours])",
            "formatString": "#,0",
            "description": "Sum of OvertimeHours at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "e1c42226-df89-56b2-b6de-6385915392e1"
          },
          {
            "name": "Payroll",
            "expression": "SUM(Workforce[Payroll])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Total payroll over selected months.",
            "displayFolder": "Business metrics",
            "lineageTag": "820fda6c-74b6-5d39-8252-254bc652dd38"
          },
          {
            "name": "Payroll per Employee Month",
            "expression": "DIVIDE([Payroll], SUM(Workforce[ClosingHeadcount]))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Payroll / sum of monthly closing headcounts; employee-month cost, not payroll / latest headcount.",
            "displayFolder": "Business metrics",
            "lineageTag": "1c0aff8f-ae40-55d4-bb69-a828390583d9"
          }
        ]
      },
