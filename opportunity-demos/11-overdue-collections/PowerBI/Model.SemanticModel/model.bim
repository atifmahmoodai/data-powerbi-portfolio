{
  "name": "Model",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Data",
        "lineageTag": "31250e18-e9bb-52b4-bf28-7f2a52f10eca",
        "columns": [
          {
            "name": "period",
            "dataType": "string",
            "sourceColumn": "period",
            "summarizeBy": "none",
            "lineageTag": "3e2d7c7e-ee22-57d3-bb2b-1f045bd2b0ac"
          },
          {
            "name": "group",
            "dataType": "string",
            "sourceColumn": "group",
            "summarizeBy": "none",
            "lineageTag": "f28d1960-b785-515f-9feb-dde8f1f6f936"
          },
          {
            "name": "item",
            "dataType": "string",
            "sourceColumn": "item",
            "summarizeBy": "none",
            "lineageTag": "3579d549-2fdb-5d93-b7e3-c8e72df6c905"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none",
            "lineageTag": "73ea84eb-66f3-516f-b6f3-adbf8f7ab0f1"
          },
          {
            "name": "actual",
            "dataType": "decimal",
            "sourceColumn": "actual",
            "summarizeBy": "none",
            "lineageTag": "7a8c2cb4-2d90-5a30-afcc-1ed46047315a"
          },
          {
            "name": "cost",
            "dataType": "decimal",
            "sourceColumn": "cost",
            "summarizeBy": "none",
            "lineageTag": "10a3e973-b2d2-5c86-a9da-dd887a637988"
          },
          {
            "name": "target",
            "dataType": "decimal",
            "sourceColumn": "target",
            "summarizeBy": "none",
            "lineageTag": "15aa359c-1b95-55ba-bdec-cb9fa97066b8"
          },
          {
            "name": "units",
            "dataType": "decimal",
            "sourceColumn": "units",
            "summarizeBy": "none",
            "lineageTag": "5f337ff3-e44e-5378-a9d7-8f646e7bd012"
          },
          {
            "name": "extra",
            "dataType": "decimal",
            "sourceColumn": "extra",
            "summarizeBy": "none",
            "lineageTag": "59730c65-831f-505a-a9c9-761247ef4606"
          }
        ],
        "measures": [
          {
            "name": "Outstanding Balance",
            "expression": "SUM(Data[actual])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Outstanding Balance",
            "lineageTag": "a7a7be6d-791f-5b01-a9f6-df9998757b50"
          },
          {
            "name": "Overdue Invoices",
            "expression": "CALCULATE(COUNTROWS(Data), Data[status] <> \"Current\")",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Overdue Invoices",
            "lineageTag": "beff9d5f-8c4e-5033-9a22-fe2c194c31b8"
          },
          {
            "name": "Overdue Balance",
            "expression": "CALCULATE(SUM(Data[actual]), Data[status] <> \"Current\")",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Overdue Balance",
            "lineageTag": "75974637-37b3-56c3-b166-148ad4af7a32"
          },
          {
            "name": "Average Days Overdue",
            "expression": "AVERAGE(Data[extra])",
            "formatString": "0.0",
            "displayFolder": "Analytics",
            "description": "Average Days Overdue",
            "lineageTag": "08fbf967-6d94-5923-b747-c075d1adee38"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/11-overdue-collections/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
