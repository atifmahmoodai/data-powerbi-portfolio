          },
          {
            "name": "SnapshotDate",
            "dataType": "dateTime",
            "sourceColumn": "SnapshotDate",
            "summarizeBy": "none",
            "lineageTag": "548d635b-561d-5c80-b38b-fa7f0b404e5e",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "ReceiptDate",
            "dataType": "dateTime",
            "sourceColumn": "ReceiptDate",
            "summarizeBy": "none",
            "lineageTag": "b967fd39-8f09-5e26-a53c-ba3598930636",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "AgeDays",
            "dataType": "int64",
            "sourceColumn": "AgeDays",
