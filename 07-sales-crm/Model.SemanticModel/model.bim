                "    Typed = Table.TransformColumnTypes(Headers, {{\"OpportunityID\", type text}, {\"OwnerID\", type text}, {\"Source\", type text}, {\"Stage\", type text}, {\"CreatedDate\", type date}, {\"ClosedDate\", type date}, {\"LastActivityDate\", type date}, {\"Amount\", Currency.Type}, {\"Probability\", Currency.Type}, {\"CycleDays\", Int64.Type}, {\"IsOpen\", Int64.Type}}, \"en-US\")",
