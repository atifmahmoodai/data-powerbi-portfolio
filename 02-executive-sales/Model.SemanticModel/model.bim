        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM(Sales[Revenue])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of Revenue at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "b4dd1d38-b83d-5882-995d-44ed0eb87d27"
          },
          {
            "name": "Cost of Sales",
            "expression": "SUM(Sales[Cost])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sum of Cost at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "cc8895e3-ada8-5447-870f-0b0a969c8862"
          },
          {
            "name": "Gross Profit",
            "expression": "[Revenue] - [Cost of Sales]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Revenue less cost of sales.",
            "displayFolder": "Business metrics",
            "lineageTag": "603a9230-fec4-532f-93ef-fc6c0b336804"
          },
          {
            "name": "Gross Margin",
            "expression": "DIVIDE([Gross Profit], [Revenue])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Gross profit / revenue.",
            "displayFolder": "Business metrics",
            "lineageTag": "ba35326c-41fe-51cd-ad0d-bcfb0c09957b"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(Sales[Units])",
            "formatString": "#,0",
            "description": "Sum of Units at the recorded grain.",
            "displayFolder": "Business metrics",
            "lineageTag": "04faae54-77b8-5e5d-8491-5d4cb3f6b8c9"
          },
          {
            "name": "Revenue Target",
            "expression": "SUM(Targets[TargetRevenue])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Daily account targets; date and account filters affect actual and target.",
            "displayFolder": "Business metrics",
            "lineageTag": "3ce89c98-8361-57f7-9c5d-61ccb1662bed"
          },
          {
            "name": "Target Attainment",
            "expression": "DIVIDE([Revenue], [Revenue Target])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Revenue divided by target.",
            "displayFolder": "Business metrics",
            "lineageTag": "055f0008-6be5-52f8-86f0-21a9a80c6911"
          },
          {
            "name": "Target Variance",
            "expression": "[Revenue] - [Revenue Target]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Positive means ahead of target.",
            "displayFolder": "Business metrics",
            "lineageTag": "fb2eb34a-1167-5d1f-9833-8fb5f756b6b9"
          },
          {
            "name": "Sales Transactions",
            "expression": "COUNTROWS(Sales)",
            "formatString": "#,0",
            "description": "Number of sales transactions.",
            "displayFolder": "Business metrics",
            "lineageTag": "b1192dcf-6428-55a5-91bc-2fec1c15a418"
          },
          {
            "name": "Active Customers",
            "expression": "DISTINCTCOUNT(Sales[AccountID])",
            "formatString": "#,0",
            "description": "Customers with a sale in the selected period.",
            "displayFolder": "Business metrics",
            "lineageTag": "633dc862-2738-525d-83f9-3e01084db4ad"
          },
          {
            "name": "Average Transaction",
            "expression": "DIVIDE([Revenue], [Sales Transactions])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Revenue per sales transaction.",
            "displayFolder": "Business metrics",
            "lineageTag": "cef74b13-c924-53d3-8f85-da37a589d8f9"
          },
          {
            "name": "Revenue YTD",
            "expression": "TOTALYTD([Revenue], 'Calendar'[Date])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Calendar-year revenue through the last selected date; select a populated period.",
            "displayFolder": "Business metrics",
            "lineageTag": "56003e9c-3781-5834-b910-81ad3f81d241"
          },
          {
            "name": "Previous Month Revenue",
            "expression": "CALCULATE([Revenue], DATEADD('Calendar'[Date], -1, MONTH))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Revenue in the date selection shifted back one month. Use a single month for month-over-month comparison.",
            "displayFolder": "Business metrics",
            "lineageTag": "d29f8362-aa60-56f3-9786-50a1a44d7421"
          },
          {
            "name": "Month Growth",
            "expression": "DIVIDE([Revenue] - [Previous Month Revenue], [Previous Month Revenue])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Revenue growth versus selected dates shifted back one month; blank if prior revenue is absent.",
            "displayFolder": "Business metrics",
            "lineageTag": "77c9978b-79ea-56e2-a877-31a37112731a"
          }
        ]
      },
