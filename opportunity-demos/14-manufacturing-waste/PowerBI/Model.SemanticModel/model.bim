        ],
        "measures": [
          {
            "name": "Good Output Units",
            "expression": "SUM(Data[units])",
            "formatString": "#,0",
            "displayFolder": "Analytics",
            "description": "Good Output Units",
            "lineageTag": "969d13f8-466e-5440-9dcf-95080d452822"
          },
          {
            "name": "Material Cost",
            "expression": "SUM(Data[cost])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Material Cost",
            "lineageTag": "f92c7a9c-e98b-59c3-af79-95e459aa6139"
          },
          {
            "name": "Waste Cost Proxy",
            "expression": "SUM(Data[cost]) * AVERAGE(Data[extra]) / 100",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Waste Cost Proxy",
            "lineageTag": "f5372bb4-376d-5bbe-b127-b10e89c401a4"
          },
          {
            "name": "Average Reject Rate",
            "expression": "DIVIDE(AVERAGE(Data[extra]), 100)",
            "formatString": "0.0%",
            "displayFolder": "Analytics",
            "description": "Average Reject Rate",
            "lineageTag": "8aeee978-585e-5a6d-a923-e544bcd9c242"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"wastecost\", Currency.Type}, {\"reject\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/14-manufacturing-waste/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
