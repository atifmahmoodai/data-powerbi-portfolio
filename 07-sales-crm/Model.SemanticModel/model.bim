        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"80lMSs3hCo70C/FwDfF0VnBx9fXnAgA=\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Metrics.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Opportunities",
            "expression": "COUNTROWS(Opportunities)",
            "formatString": "#,0",
            "description": "Count of opportunities created in the selected cohort.",
            "displayFolder": "Business metrics",
            "lineageTag": "7c1b7519-8dd1-521a-b1ae-d97e2569c6a2"
          },
          {
            "name": "Open Opportunities",
            "expression": "CALCULATE(COUNTROWS(Opportunities), KEEPFILTERS(Opportunities[IsOpen] = 1))",
            "formatString": "#,0",
            "description": "Currently open opportunities in the creation cohort.",
            "displayFolder": "Business metrics",
            "lineageTag": "4c446096-59b5-5342-a580-46bbdda12f69"
          },
          {
            "name": "Open Pipeline",
            "expression": "CALCULATE(SUM(Opportunities[Amount]), KEEPFILTERS(Opportunities[IsOpen] = 1))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Current amount of open opportunities.",
            "displayFolder": "Business metrics",
            "lineageTag": "08cd67e9-112b-57f5-836c-c716348d1538"
          },
          {
            "name": "Weighted Pipeline",
            "expression": "CALCULATE(SUMX(Opportunities, Opportunities[Amount] * Opportunities[Probability]), KEEPFILTERS(Opportunities[IsOpen] = 1))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Open amount × stage probability; heuristic, not a calibrated forecast.",
            "displayFolder": "Business metrics",
            "lineageTag": "c488196f-9722-541d-b065-9fba7e5b6008"
          },
          {
            "name": "Won Deals",
            "expression": "CALCULATE(COUNTROWS(Opportunities), KEEPFILTERS(Opportunities[Stage] = \"Won\"))",
            "formatString": "#,0",
            "description": "Won opportunities in the selected creation cohort.",
            "displayFolder": "Business metrics",
            "lineageTag": "5de48464-819d-531a-992e-793b4987057f"
          },
          {
            "name": "Lost Deals",
            "expression": "CALCULATE(COUNTROWS(Opportunities), KEEPFILTERS(Opportunities[Stage] = \"Lost\"))",
            "formatString": "#,0",
            "description": "Lost opportunities in the selected creation cohort.",
            "displayFolder": "Business metrics",
            "lineageTag": "60157fd4-223d-5a23-8310-5b50d25acf48"
          },
          {
            "name": "Won Value",
            "expression": "CALCULATE(SUM(Opportunities[Amount]), KEEPFILTERS(Opportunities[Stage] = \"Won\"))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Won deal amount; bookings, not recognized accounting revenue.",
            "displayFolder": "Business metrics",
            "lineageTag": "fb9bcc7d-3d19-5379-9e1d-96b43403e0c6"
          },
          {
            "name": "Win Rate",
            "expression": "DIVIDE([Won Deals], [Won Deals] + [Lost Deals])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Wins divided by wins plus losses; excludes open deals.",
            "displayFolder": "Business metrics",
            "lineageTag": "016e2436-176e-52fb-8f55-7029cb354115"
          },
          {
            "name": "Average Won Deal",
            "expression": "DIVIDE([Won Value], [Won Deals])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Won value / won count.",
            "displayFolder": "Business metrics",
            "lineageTag": "b9c45e31-01bc-5f87-b1d7-22f25b23287f"
          },
          {
            "name": "Average Sales Cycle",
            "expression": "CALCULATE(AVERAGE(Opportunities[CycleDays]), KEEPFILTERS(Opportunities[Stage] = \"Won\"))",
            "formatString": "#,0.0",
            "description": "Mean creation-to-close days for wins.",
            "displayFolder": "Business metrics",
            "lineageTag": "e84f480a-0ea0-5574-9413-636d19870ea9"
          },
          {
            "name": "Stale Open Deals",
            "expression": "CALCULATE([Open Opportunities], KEEPFILTERS(Opportunities[LastActivityDate] < DATE(2026,9,30) - 14))",
            "formatString": "#,0",
            "description": "Open deals with no activity for more than 14 days at the demo as-of date.",
            "displayFolder": "Business metrics",
            "lineageTag": "853afcab-fb5a-53f7-8516-b8b1eafb1100"
          },
          {
            "name": "Stale Pipeline",
            "expression": "CALCULATE([Open Pipeline], KEEPFILTERS(Opportunities[LastActivityDate] < DATE(2026,9,30) - 14))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Amount of stale open deals at the demo as-of date.",
            "displayFolder": "Business metrics",
            "lineageTag": "9fe34026-43b4-574e-b4a9-74f7b013d76d"
          }
        ]
      },
