        ],
        "measures": [
          {
            "name": "Earned Value",
            "expression": "SUM(Data[actual])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Earned Value",
            "lineageTag": "54be697f-9f60-5aaa-81fe-85f2656a5157"
          },
          {
            "name": "Planned Value",
            "expression": "SUM(Data[target])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Planned Value",
            "lineageTag": "ffc69d64-4405-594e-9cf6-3e3999b548eb"
          },
          {
            "name": "Actual Cost",
            "expression": "SUM(Data[cost])",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Actual Cost",
            "lineageTag": "828c6891-1ba5-5332-82cd-d27d0116d521"
          },
          {
            "name": "Schedule Variance",
            "expression": "[Earned Value] - [Planned Value]",
            "formatString": "\"PKR \"#,0",
            "displayFolder": "Analytics",
            "description": "Schedule Variance",
            "lineageTag": "47e45d25-e5dd-531c-9982-a73d9086cfeb"
          }
        ],
        "partitions": [
          {
            "name": "Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sample = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Sample else File.Contents(DataFolder),",
                "    Parsed = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Parsed, {{\"period\", type text}, {\"group\", type text}, {\"item\", type text}, {\"status\", type text}, {\"actual\", Currency.Type}, {\"cost\", Currency.Type}, {\"target\", Currency.Type}, {\"units\", Currency.Type}, {\"extra\", Currency.Type}, {\"variance\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "DataMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, List={\"Demo\", \"CSV\"}, DefaultValue=\"Demo\", Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/Astra/15-construction-analytics/data.csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
