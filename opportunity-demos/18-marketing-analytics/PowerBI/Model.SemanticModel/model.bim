            "sourceColumn": "actual",
            "summarizeBy": "none",
            "lineageTag": "8e69c9b2-3e02-539b-8de5-8db80cda1bea"
          },
          {
            "name": "cost",
            "dataType": "decimal",
            "sourceColumn": "cost",
            "summarizeBy": "none",
            "lineageTag": "ed60eb02-4974-5aec-b355-4a80f549300b"
          },
          {
