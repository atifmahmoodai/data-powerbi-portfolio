            "sourceColumn": "AgeBand",
            "summarizeBy": "none",
            "lineageTag": "21b803fd-fd93-5da2-b8f5-3e644821a3e3"
          }
        ],
        "partitions": [
          {
            "name": "Vehicles",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Vehicles.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"VehicleID\", type text}, {\"Make\", type text}, {\"Model\", type text}, {\"Branch\", type text}, {\"Salesperson\", type text}, {\"Status\", type text}, {\"PurchaseDate\", type date}, {\"SaleDate\", type date}, {\"PurchaseCost\", Currency.Type}, {\"Reconditioning\", Currency.Type}, {\"SalePrice\", Currency.Type}, {\"DaysHeld\", Int64.Type}, {\"AgeBand\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Metrics",
        "lineageTag": "801e62bd-5049-5ece-bb8c-75469907dea6",
        "columns": [
          {
            "name": "Label",
            "dataType": "string",
            "sourceColumn": "Label",
            "summarizeBy": "none",
            "lineageTag": "c2227322-8f05-5877-9d34-cab9621e5b89",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Demo = Binary.Decompress(Binary.FromText(\"80lMSs3hCo70C/FwDfF0VnBx9fXnAgA=\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = if DataMode = \"Demo\" then Demo else if DataMode = \"Folder\" then File.Contents(DataFolder & \"/Metrics.csv\") else error \"DataMode must be Demo or Folder\",",
                "    Parsed = Csv.Document(Source, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Units Sold",
            "expression": "CALCULATE(COUNTROWS(Vehicles), KEEPFILTERS(Vehicles[Status] = \"Sold\"))",
            "formatString": "#,0",
            "description": "Count of vehicles with completed sales.",
            "displayFolder": "Business metrics",
            "lineageTag": "1dd20ebf-d0a0-5071-a28a-bca04010e0da"
          },
          {
            "name": "Sales Revenue",
            "expression": "CALCULATE(SUM(Vehicles[SalePrice]), KEEPFILTERS(Vehicles[Status] = \"Sold\"))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Sale price of sold vehicles, excluding tax.",
            "displayFolder": "Business metrics",
            "lineageTag": "52401810-ffa0-5d10-b6ff-6be2575b548b"
          },
          {
            "name": "Sold Vehicle Cost",
            "expression": "CALCULATE(SUMX(Vehicles, Vehicles[PurchaseCost] + Vehicles[Reconditioning]), KEEPFILTERS(Vehicles[Status] = \"Sold\"))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Purchase plus reconditioning cost of sold vehicles.",
            "displayFolder": "Business metrics",
            "lineageTag": "03e0080f-b749-56e5-9c48-58b56f6affbb"
          },
          {
            "name": "Gross Profit",
            "expression": "[Sales Revenue] - [Sold Vehicle Cost]",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Vehicle gross profit before finance costs and operating overhead.",
            "displayFolder": "Business metrics",
            "lineageTag": "49ee90ad-69bf-5fe0-94ba-1bcf67c783ec"
          },
          {
            "name": "Gross Margin",
            "expression": "DIVIDE([Gross Profit], [Sales Revenue])",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Vehicle gross profit divided by sales revenue.",
            "displayFolder": "Business metrics",
            "lineageTag": "85159cc8-3e81-50a1-aec1-6b86561da145"
          },
          {
            "name": "Stock Units",
            "expression": "CALCULATE(COUNTROWS(Vehicles), KEEPFILTERS(Vehicles[Status] = \"In Stock\"))",
            "formatString": "#,0",
            "description": "Vehicles in stock at the 30 September 2026 snapshot.",
            "displayFolder": "Business metrics",
            "lineageTag": "caa6ac9c-030f-59c2-b577-315ac2713866"
          },
          {
            "name": "Stock Value",
            "expression": "CALCULATE(SUMX(Vehicles, Vehicles[PurchaseCost] + Vehicles[Reconditioning]), KEEPFILTERS(Vehicles[Status] = \"In Stock\"))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Capitalized purchase and reconditioning cost of current stock.",
            "displayFolder": "Business metrics",
            "lineageTag": "c039caa0-a260-57a4-805d-03c0474cf8a4"
          },
          {
            "name": "Average Stock Age",
            "expression": "CALCULATE(AVERAGE(Vehicles[DaysHeld]), KEEPFILTERS(Vehicles[Status] = \"In Stock\"))",
            "formatString": "#,0.0",
            "description": "Average days since purchase for current stock.",
            "displayFolder": "Business metrics",
            "lineageTag": "48a39863-c84a-54eb-8d4a-05b516e69c79"
          },
          {
            "name": "Aged Stock Units",
            "expression": "CALCULATE([Stock Units], KEEPFILTERS(Vehicles[DaysHeld] > 90))",
            "formatString": "#,0",
            "description": "Current unsold vehicles older than 90 days.",
            "displayFolder": "Business metrics",
            "lineageTag": "4406f1fa-8d56-5b39-b88d-1809b8585ec2"
          },
          {
            "name": "Aged Stock Value",
            "expression": "CALCULATE([Stock Value], KEEPFILTERS(Vehicles[DaysHeld] > 90))",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Cost tied up in stock older than 90 days.",
            "displayFolder": "Business metrics",
            "lineageTag": "5227d6a1-61d1-5b0f-80ea-49dad45331fe"
          },
          {
            "name": "Average Days to Sell",
            "expression": "CALCULATE(AVERAGE(Vehicles[DaysHeld]), KEEPFILTERS(Vehicles[Status] = \"Sold\"))",
            "formatString": "#,0.0",
            "description": "Mean purchase-to-sale duration of completed sales.",
            "displayFolder": "Business metrics",
            "lineageTag": "28c55a0c-34a0-5fa5-99ed-e7630fe02a5a"
          },
          {
            "name": "Profit per Vehicle",
            "expression": "DIVIDE([Gross Profit], [Units Sold])",
            "formatString": "\"PKR \"#,0;(\"PKR \"#,0);\"PKR \"0",
            "description": "Mean gross profit per sold vehicle.",
            "displayFolder": "Business metrics",
            "lineageTag": "2c426308-6a7c-547c-adc0-c1b4f0cdecee"
          }
        ]
      },
